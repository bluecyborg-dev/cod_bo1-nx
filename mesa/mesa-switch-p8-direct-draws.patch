diff --git a/src/util/os_misc.c b/src/util/os_misc.c
index 4eb0fd98843..87d79ab39da 100644
--- a/src/util/os_misc.c
+++ b/src/util/os_misc.c
@@ -483,6 +483,17 @@ os_get_available_system_memory(uint64_t *size)
    const uintptr_t heap_end = (uintptr_t)fake_heap_end;
 
    if (heap_start && heap_end > heap_start) {
+      /* mallinfo walks the whole newlib heap under its lock, and VMA asks for
+       * the budget every few dozen allocations: in a game creating textures
+       * as it streams, that was several percent of the thread recording draws.
+       * A value up to 100 ms old is as good for a budget.
+       */
+      static uint64_t cached_size, cached_tick;
+      const uint64_t now = armGetSystemTick();
+      if (cached_tick && now - cached_tick < armGetSystemTickFreq() / 10) {
+         *size = cached_size;
+         return true;
+      }
       const uint64_t heap_size = heap_end - heap_start;
       const struct mallinfo allocator = mallinfo();
       const uint64_t arena = MIN2((uint64_t)allocator.arena, heap_size);
@@ -494,6 +505,8 @@ os_get_available_system_memory(uint64_t *size)
        * Counting both also makes the value recover when BO storage is freed.
        */
       *size = heap_size - arena + reusable;
+      cached_size = *size;
+      cached_tick = now;
       return true;
    }
 
